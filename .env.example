# Copiar para .env e ajustar. O ficheiro .env NUNCA vai para o Git.
CRM_AMBIENTE=dev
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=trocar-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Usado pelo docker compose
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
